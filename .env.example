# App
APP_URL=http://localhost:3000

# Database / cache / queues
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bike_parts
REDIS_URL=redis://localhost:6379

# Search — Meilisearch is optional. Configured: search hits the live index.
# Not configured (any of these blank): search transparently falls back to
# querying PostgreSQL directly (see lib/search/db-fallback.ts) — this is a
# supported production configuration, not a degraded one.
MEILISEARCH_HOST=
MEILISEARCH_PORT=7700
MEILISEARCH_PROTOCOL=http
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=bike_parts
MEILISEARCH_HTTP_TIMEOUT_MS=5000

# Cloudflare R2 — product image storage (lib/storage/product-images.ts).
# All five are required in production; missing any one fails uploads closed
# rather than writing to local disk. Outside production (NODE_ENV !==
# "production"), leaving these blank falls back to local disk under
# public/uploads-dev instead — fine for a laptop with no bucket to hand.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=bike-parts
# Public URL the bucket is served from — a custom domain or the bucket's
# r2.dev URL. Must be readable publicly; write access stays server-side only.
CLOUDFLARE_R2_PUBLIC_URL=

# Cloudflare Images — unused by product image storage (that's R2 above);
# reserved for a possible future on-the-fly image transform integration.
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_API_TOKEN=

# Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Must be a strong random value in production (32+ chars) — see
# getOtpHashSecret() in lib/auth/customer-session.ts.
CUSTOMER_OTP_HASH_SECRET=
# Never "true" in production — echoes OTPs back in the API response instead
# of sending SMS. Local/E2E use only.
CUSTOMER_OTP_DEV_MODE=false
# "twilio" or "a2p" — see lib/auth/send-customer-otp.ts. Configure the
# matching section below for whichever provider you set here.
CUSTOMER_SMS_PROVIDER=a2p
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# a2pservices.in SendSMS provider config.
SMS_A2P_BASE_URL=http://a2pservices.in/api/mt/SendSMS
SMS_A2P_USER=
SMS_A2P_PASSWORD=
SMS_A2P_SENDER_ID=
SMS_A2P_CHANNEL=Trans
SMS_A2P_DCS=0
SMS_A2P_FLASH_SMS=0
SMS_A2P_ROUTE=3
SMS_A2P_PEID=

# Notifications
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payments / delivery
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PORTER_API_KEY=
PORTER_API_BASE_URL=https://pfe-apigw-uat.porter.in
PORTER_ENV=uat
PORTER_CLIENT_ID=
PORTER_HTTP_TIMEOUT_MS=10000

# Warehouse / pickup address used when dispatching a Porter delivery
WAREHOUSE_CONTACT_NAME=BikeParts Warehouse
WAREHOUSE_PHONE=
WAREHOUSE_ADDRESS_LINE1=
WAREHOUSE_CITY=
WAREHOUSE_PINCODE=

# Admin panel (/admin) — single admin account, session cookie is HMAC-signed.
# ADMIN_SESSION_SECRET must be a strong random value in production (32+
# chars, not a dictionary word — see lib/auth/admin-session.ts). Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Bump this (any short string, e.g. "2") to invalidate every previously
# issued admin session at once — an emergency "log everyone out" switch that
# doesn't require rotating ADMIN_SESSION_SECRET. Required in production.
ADMIN_SESSION_VERSION=1

# Set to "true" only when this app sits behind a trusted reverse proxy
# (Cloudflare, nginx, your hosting provider's load balancer) that itself
# sets CF-Connecting-IP/X-Forwarded-For/X-Real-IP and cannot be bypassed by
# a client setting those headers directly. If the app is directly
# internet-facing, leave this unset/false — see lib/security/client-ip.ts.
TRUST_PROXY_HEADERS=false

# Monitoring / analytics
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
